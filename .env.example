# Copy to .env.local and fill in. Never put real values in this file: it is committed.

# Local Supabase (`supabase start` prints these). Hosted values go in .env.remote.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only, never NEXT_PUBLIC_: uploads plan material to the private Storage bucket. It bypasses RLS.
# Local: the "Secret" API key from `supabase status` (starts sb_secret_), not the S3 secret key.
SUPABASE_SECRET_KEY=

# Used by `supabase config push` for hosted Supabase Auth SMTP (Resend).
# Not needed by the Next.js app or in Vercel. Local auth uses Mailpit.
RESEND_API_KEY=

# Postgres for Drizzle. Hosted: use the pooler (transaction mode, port 6543).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres

# Claude for every route. ANTHROPIC_MODEL is the default until you pick Haiku or Sonnet under the chat bar (saved in a cookie).
ANTHROPIC_API_KEY=
# Server only: the tutor's web search in plan sessions (tavily.com, 1,000 free searches a month). Without it, search
# tells the tutor it isn't set up.
TAVILY_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
