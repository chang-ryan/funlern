# Supabase (Project Settings → API). Local: `supabase start` prints these.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Postgres for Drizzle. Hosted: use the pooler (transaction mode, port 6543).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# 32-byte base64 key for encrypting BYO model API keys: `openssl rand -base64 32`
MODEL_KEY_SECRET=

# Dev-only model for the unpersisted chat on `/`.
# DEV_PROVIDER: anthropic | openai | google | deepseek | moonshotai | zai | openrouter | openai-compatible
DEV_PROVIDER=anthropic
DEV_MODEL=claude-sonnet-5-5
DEV_API_KEY=
DEV_BASE_URL=
